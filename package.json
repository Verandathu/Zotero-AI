{
  "name": "zotero-ai",
  "type": "module",
  "version": "0.1.0",
  "description": "AI assistant for Zotero: context-aware chat, full-text analysis, and quick actions",
  "config": {
    "addonName": "Zotero AI",
    "addonID": "zoteroai@zixuwang",
    "addonRef": "zoteroai",
    "addonInstance": "ZoteroAI",
    "prefsPrefix": "extensions.zotero.zoteroai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windingwind/zotero-plugin-template.git"
  },
  "author": "windingwind",
  "bugs": {
    "url": "https://github.com/windingwind/zotero-plugin-template/issues"
  },
  "homepage": "https://github.com/windingwind/zotero-plugin-template#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
